---
import Container from '@/components/ui/Container.astro';
import { FaqAccordion } from '@/components/islands/FaqAccordion';
import { faq } from '@/data/faq';
---

<section class="py-12 md:py-16">
  <Container>
    <p class="text-eyebrow font-bold uppercase text-rust">Preguntas frecuentes</p>
    <h2 class="mt-1 text-display md:text-4xl">Todo lo que necesitás saber</h2>

    <div class="mt-6">
      <FaqAccordion client:visible items={faq} />
    </div>
  </Container>
</section>
