---
import { product } from '@/data/product';
import { CartButton } from '@/components/islands/CartButton';
---

<header class="sticky top-9 z-40 flex h-14 items-center justify-between bg-white px-5">
  <span class="font-display text-xl font-black leading-none tracking-tight text-graphite">
    {product.brand}<span class="align-super text-[0.6em] text-grape">™</span>
  </span>

  <CartButton client:load />
</header>
