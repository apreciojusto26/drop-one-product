---
import { product } from '@/data/product';
---

<header class="flex h-14 items-center justify-between px-5">
  <span class="font-display text-xl font-black tracking-tight text-graphite">
    {product.brand}<span class="align-super text-[0.6em] text-rust">™</span>
  </span>

  <svg viewBox="0 0 24 24" class="size-6 text-graphite" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M7 4h-2a1 1 0 000 2h1.28l1.7 8.53A2 2 0 0010 16h7a2 2 0 001.95-1.56L20.7 8H6.16l-.4-2H7zm2 12a2 2 0 100 4 2 2 0 000-4zm8 0a2 2 0 100 4 2 2 0 000-4z"
    ></path>
  </svg>
</header>
